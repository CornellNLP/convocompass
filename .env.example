# Copy to .env and fill in. .env is gitignored — never commit it.

# --- database ---------------------------------------------------------------
# Root password for the bundled MySQL container. Any value; used by mysql_db,
# init_db and the extension backend alike.
MYSQL_PASSWORD=change-me

# --- reddit api (optional) --------------------------------------------------
# Not used by any request path today; leave blank unless you add code that does.
# Create a "script" app at https://www.reddit.com/prefs/apps to get these.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=convocompass

# --- perspective api --------------------------------------------------------
# Toxicity scores, used alongside the forecaster. Request access at
# https://developers.perspectiveapi.com/
PERSPECTIVE_API_KEY=

# --- study configuration ----------------------------------------------------
# Reddit username allowed to call the /add_user and /view_users admin routes.
ADMIN_USERNAME=
# Where participants are sent once their study window closes. Leave blank to
# disable the link in the end-of-study message.
EXIT_SURVEY_URL=

# Comma separated origins allowed to call the backend API.
CORS_ORIGINS=https://www.reddit.com,https://old.reddit.com

# --- model ------------------------------------------------------------------
# "roberta" routes scoring to the roberta-model-service; "craft" uses the
# original CRAFT RNN in-process (checkpoint auto-downloads on first run).
MODEL_TYPE=roberta
MODEL_REQUEST_TIMEOUT=10

# Hugging Face repo id for the fine-tuned forecaster. Only used when no local
# checkpoint is mounted at roberta-model-service/roberta-model-checkpoint/.
HF_REPO_ID=

# "cuda" or "cpu". If you set cuda, also uncomment the deploy block for
# roberta-service in docker-compose.yml.
ROBERTA_DEVICE=cpu
